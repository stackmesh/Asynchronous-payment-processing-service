# Copy to .env for a local run outside Docker.
# docker-compose.yml overrides the hosts for the containers.

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
API_KEY=dev-api-key

# Emulated gateway: 2-5 seconds, 90% approval.
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5

# Webhook HTTP attempts inside a single processing attempt.
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_BACKOFF_SECONDS=1

# Broker attempts. After this many failures the message goes to payments.dlq.
PROCESSING_MAX_ATTEMPTS=3

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
PREFETCH_COUNT=10
